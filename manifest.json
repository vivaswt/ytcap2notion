{
  "manifest_version": 3,
  "name": "YouTube Transcript to Notion",
  "version": "1.0",
  "description": "Extract YouTube transcripts and save them to a Notion database.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.notion.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
    "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}